#!/bin/sh

set -eu

mode="${BSDRUNNER_BLACKSHIP_FIXTURE_MODE:-missing}"
[ "$mode" != missing ] || exit 127

{
    printf 'blackship'
    printf ' %s' "$@"
    printf '\n'
} >>"$BSDRUNNER_JAILS_TEST_LOG"

args=" $* "
case "$args" in
    *" capabilities "*)
        if [ "$mode" = malformed ]; then
            printf '%s\n' '{not-json'
            exit 0
        fi
        version="${BSDRUNNER_BLACKSHIP_FIXTURE_VERSION:-0.4.1}"
        schema="${BSDRUNNER_BLACKSHIP_FIXTURE_SCHEMA:-1}"
        printf '{\n  "schema_version": %s,\n  "ok": true,\n  "data": {\n    "blackship_version": "%s",\n    "output_schema_version": %s\n  },\n  "blackship_version": "%s",\n  "output_schema_version": %s\n}\n' "$schema" "$version" "$schema" "$version" "$schema"
        ;;
    *" check "*)
        [ "${BSDRUNNER_BLACKSHIP_FIXTURE_REJECT:-0}" != 1 ]
        printf '%s\n' '{"schema_version":1,"ok":true,"data":{"valid":true}}'
        ;;
    *" template validate "*)
        printf '%s\n' 'Template is valid'
        ;;
    *" ps --host "*)
        printf '%s\n' '{"schema_version":1,"ok":true,"data":{"project":"bsdrunner","config_path":"blackship.toml","jails":[{"service_name":"web","full_name":"bsdrunner-web","manager":"blackship","managed":true,"configured":true,"running":true,"state":"Running","jid":4,"release":"15.0-RELEASE","hostname":"web.local","ip":"10.44.0.20","ips":["10.44.0.20"],"path":"/var/db/bsdrunner/blackship/jails/bsdrunner-web","networks":["bsdrunner"],"depends_on":[]}]}}'
        ;;
    *" network list "*)
        printf '%s\n' '{"schema_version":1,"ok":true,"data":[]}'
        ;;
    *" host "*|*" releases list "*|*" ports "*|*" stats "*|*" health "*|*" audit "*)
        printf '%s\n' '{"schema_version":1,"ok":true,"data":[]}'
        ;;
    *)
        printf '%s\n' '{"schema_version":1,"ok":true,"data":{}}'
        ;;
esac
