#!/bin/sh

set -eu

loopback_ready=true
if [ -n "${BSDRUNNER_JAILS_TEST_LOOPBACK_STATE:-}" ] && [ ! -f "$BSDRUNNER_JAILS_TEST_LOOPBACK_STATE" ]; then
    loopback_ready=false
fi

case "${1:-}" in
    -a)
        printf '%s\n' 'wlan0: flags=8843<UP,BROADCAST,RUNNING,SIMPLEX,MULTICAST>'
        printf '%s\n' '        inet 192.168.1.210 netmask 0xffffff00 broadcast 192.168.1.255'
        if [ "$loopback_ready" = true ]; then
            printf '%s\n' 'bastille0: flags=8049<UP,LOOPBACK,RUNNING,MULTICAST>'
        fi
        ;;
    wlan0)
        printf '%s\n' 'wlan0: flags=8843<UP,BROADCAST,RUNNING,SIMPLEX,MULTICAST>'
        ;;
    bastille0)
        [ "$loopback_ready" = true ] || exit 1
        printf '%s\n' 'bastille0: flags=8049<UP,LOOPBACK,RUNNING,MULTICAST>'
        ;;
    lo1)
        [ -n "${BSDRUNNER_JAILS_TEST_LOOPBACK_SOURCE_STATE:-}" ] || exit 1
        [ -f "$BSDRUNNER_JAILS_TEST_LOOPBACK_SOURCE_STATE" ] || exit 1
        if [ "${2:-}" = "name" ] && [ "${3:-}" = "bastille0" ]; then
            {
                printf 'ifconfig'
                printf ' %s' "$@"
                printf '\n'
            } >>"$BSDRUNNER_JAILS_TEST_LOG"
            : >"$BSDRUNNER_JAILS_TEST_LOOPBACK_STATE"
            rm -f "$BSDRUNNER_JAILS_TEST_LOOPBACK_SOURCE_STATE"
        else
            printf '%s\n' 'lo1: flags=8008<LOOPBACK,MULTICAST>'
        fi
        ;;
    *)
        exit 1
        ;;
esac
