{
  "label" : "lock",
  "action" : "sh ~/.config/bsdrunner/scripts/bsdrunner-lock.sh",
  "text" : "Lock",
  "keybind" : "l"
}

{
  "label" : "logout",
  "action" : "sh ~/.config/bsdrunner/scripts/bsdrunner-logout.sh",
  "text" : "Logout",
  "keybind" : "e"
}

{
  "label" : "suspend",
  "action" : "command -v zzz >/dev/null 2>&1 && zzz",
  "text" : "Suspend",
  "keybind" : "u"
}

{
  "label" : "reboot",
  "action" : "sh ~/.config/bsdrunner/scripts/bsdrunner-power-action.sh reboot",
  "text" : "Reboot",
  "keybind" : "r"
}

{
  "label" : "shutdown",
  "action" : "sh ~/.config/bsdrunner/scripts/bsdrunner-power-action.sh shutdown",
  "text" : "Shutdown",
  "keybind" : "s"
}

{
  "label" : "cancel",
  "action" : "pkill wlogout",
  "text" : "Cancel",
  "keybind" : "c"
}
