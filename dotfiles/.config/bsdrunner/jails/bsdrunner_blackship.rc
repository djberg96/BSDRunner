#!/bin/sh
# PROVIDE: bsdrunner_blackship
# REQUIRE: LOGIN zfs pf
# KEYWORD: shutdown

. /etc/rc.subr

name="bsdrunner_blackship"
rcvar="bsdrunner_blackship_enable"
command="/usr/local/bin/blackship"
start_cmd="bsdrunner_blackship_start"
stop_cmd="bsdrunner_blackship_stop"

bsdrunner_blackship_run()
{
    for config_path in $(ls -1r /usr/local/etc/bsdrunner/blackship.d/*.toml 2>/dev/null); do
        set -- --config "$config_path" "$@"
    done
    set -- --config /usr/local/etc/bsdrunner/blackship.toml "$@"
    /usr/local/bin/blackship "$@"
}

bsdrunner_blackship_start()
{
    bsdrunner_blackship_run --non-interactive setup || return 1
    bsdrunner_blackship_run --non-interactive autostart
}

bsdrunner_blackship_stop()
{
    bsdrunner_blackship_run --non-interactive down --all
}

load_rc_config "$name"
: ${bsdrunner_blackship_enable:="NO"}
run_rc_command "$1"
